[Unit]
Description=CREO+ user-space DRL inference service
After=network.target
ConditionPathExists=/dev/creo_drl

[Service]
Type=simple
WorkingDirectory=/opt/creo-plus/linux-creo
ExecStartPre=/bin/sh -c 'echo Y > /sys/module/tcp_creo/parameters/drl_enabled'
Environment=CREO_TORCH_THREADS=1
ExecStart=/opt/creo-plus/linux-creo/.venv/bin/python /opt/creo-plus/linux-creo/deployment/creo_drl_daemon.py --state-dir /var/lib/creo-drl
ExecStopPost=/bin/sh -c 'echo N > /sys/module/tcp_creo/parameters/drl_enabled'
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
